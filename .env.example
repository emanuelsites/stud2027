# Banco libSQL persistente (Turso). Configure as mesmas variáveis na Vercel.
TURSO_DATABASE_URL=libsql://SEU-BANCO-SUA-ORGANIZACAO.turso.io
TURSO_AUTH_TOKEN=
# Para testar localmente, use TURSO_DATABASE_URL=file:./data/studpb-dev.db
# e deixe TURSO_AUTH_TOKEN vazio. Arquivo local não é aceito na Vercel.

# Uma conta inicial, criada por npm run db:setup. Senha com 16 a 200 caracteres.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_EMAIL=

# Vercel Blob: crie um store PUBLIC e conecte ao projeto.
# As imagens existentes estão em public/assets; este token habilita novos uploads.
BLOB_READ_WRITE_TOKEN=

# Preencha antes do build com a URL final; usada em traduções e canonical.
SITE_URL=https://www.seudominio.com.br

# Recuperação de senha pelo script admin:password (não definir na Vercel).
# ADMIN_USERNAME=admin
# ADMIN_NEW_PASSWORD=

    "db:import": "node --env-file-if-exists=.env.local scripts/import-database.mjs",
    "admin:password": "node --env-file-if-exists=.env.local scripts/admin-password.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@libsql/client": "0.18.0",
    "@vercel/blob": "2.9.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
